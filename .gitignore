# ==============================================================================
# ROYAL INDIAN STAYS - GIT IGNORE CONFIGURATION
# Standard .gitignore for Java / Spring Boot, Maven, IDEs, and local environments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SENSITIVE CREDENTIALS, SECRETS & ENVIRONMENT VARIABLES
# ------------------------------------------------------------------------------
# Environment variable files containing secrets or database passwords
.env
.env.*
!.env.example
*.env
local.properties
application-local.properties
application-local.yml
application-secret.properties
application-secret.yml

# Session dumps, auth tokens and cookie stores
guest_cookies.txt
*cookies*.txt
*token*
!*csrf*

# Private keys, certificates and keystores
*.key
*.pem
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks

# ------------------------------------------------------------------------------
# 2. JAVA & MAVEN BUILD ARTIFACTS
# ------------------------------------------------------------------------------
*.class
target/
build/
out/
bin/

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven release and backup files
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# JVM crash logs
hs_err_pid*
replay_pid*

# ------------------------------------------------------------------------------
# 3. LOGS & DIAGNOSTIC DUMPS
# ------------------------------------------------------------------------------
*.log
logs/
chrome_dom.html
chrome_err.log

# ------------------------------------------------------------------------------
# 4. SCRATCH DIRECTORIES & TEMPORARY FILES
# ------------------------------------------------------------------------------
# Scratch folder (contains 55MB cloudflared binary, chrome profiles, test runs)
scratch/
.tmp/
tmp/
temp/
*.tmp
*.bak
*.swp
*.swo
*~

# Python cache & scraper scratch files (used during data preparation)
__pycache__/
*.py[cod]
*$py.class
*.py

# Scraper data dumps and test fixtures in root directory
/hotels_list.json
/hotel_image_candidates*.json
/scratch_hotels.json
/scratch_directory_text.txt

# Redundant unpack directories in root (Clean web assets reside in src/main/resources/static/images/)
/background animation/
/logo animation/

# Locally generated runtime connect files
/mobile-qr.png
/mobile-connect.html

# ------------------------------------------------------------------------------
# 5. IDE & EDITOR CONFIGURATIONS
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-userId

# BlueJ
*.ctxt

# NetBeans
nbproject/private/
nbbuild/
dist/
nbdist/

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM ARTIFACTS
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
