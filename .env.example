# ==============================================================================
# ROYAL INDIAN STAYS - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' and fill in the values for your environment.
# DO NOT COMMIT THE ACTUAL '.env' FILE TO VERSION CONTROL.
# ==============================================================================

# Server & Profile Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Production PostgreSQL Database Connection
# On Railway, the DATABASE_URL is automatically provided by the PostgreSQL service.
DATABASE_URL=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Security & Admin Access Credentials (Injected at Runtime)
ADMIN_GAGAN_PASSWORD=
ADMIN_DARSHAN_PASSWORD=

# Optional Custom Domain / Host Settings
PUBLIC_DOMAIN=
